<section class="pagina-error">

    <div class="error-contenido">

        <span class="error-codigo">
            404
        </span>

        <h1>
            <%= titulo %>
        </h1>

        <p>
            <%= mensaje %>
        </p>

        <div class="error-acciones">

            <a
                href="/"
                class="boton boton-azul"
            >
                Volver al inicio
            </a>

            <a
                href="/reservas"
                class="boton boton-claro"
            >
                Ver reservas
            </a>

        </div>

    </div>

</section>