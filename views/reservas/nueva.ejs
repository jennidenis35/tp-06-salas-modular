<section class="cabecera-pagina">

    <span class="etiqueta-azul">
        <%= seccion %>
    </span>

    <h1>Nueva reserva</h1>

    <p>
        Completá los datos para reservar una sala de estudio.
        Todos los campos son obligatorios.
    </p>

</section>


<section class="formulario-contenedor">

    <% if (error) { %>

        <div class="mensaje-error" role="alert">
            <strong>No pudimos registrar la reserva.</strong>
            <span><%= error %></span>
        </div>

    <% } %>


    <form
        action="/reservas"
        method="POST"
        class="formulario-reserva"
    >

        <div class="campo campo-completo">

            <label for="estudiante">
                Nombre del estudiante
            </label>

            <input
                type="text"
                id="estudiante"
                name="estudiante"
                value="<%= datos.estudiante || '' %>"
                placeholder="Ej: María López"
            >

        </div>


        <div class="campo campo-completo">

            <label for="email">
                Correo electrónico
            </label>

            <input
                type="text"
                id="email"
                name="email"
                value="<%= datos.email || '' %>"
                placeholder="Ej: maria@email.com"
            >

        </div>


        <div class="campo">

            <label for="sala">
                Sala
            </label>

            <select
                id="sala"
                name="sala"
            >

                <option value="">
                    Seleccioná una sala
                </option>

                <% salasPermitidas.forEach((sala) => { %>

                    <option
                        value="<%= sala %>"
                        <%= datos.sala === sala ? "selected" : "" %>
                    >
                        <%= sala %>
                    </option>

                <% }) %>

            </select>

        </div>


        <div class="campo">

            <label for="fecha">
                Fecha
            </label>

            <input
                type="date"
                id="fecha"
                name="fecha"
                value="<%= datos.fecha || '' %>"
            >

        </div>


        <div class="campo">

            <label for="turno">
                Turno
            </label>

            <select
                id="turno"
                name="turno"
            >

                <option value="">
                    Seleccioná un turno
                </option>

                <% turnosPermitidos.forEach((turno) => { %>

                    <option
                        value="<%= turno %>"
                        <%= datos.turno === turno ? "selected" : "" %>
                    >
                        <%= turno %>
                    </option>

                <% }) %>

            </select>

        </div>


        <div class="campo">

            <label for="personas">
                Cantidad de personas
            </label>

            <input
                type="number"
                id="personas"
                name="personas"
                min="1"
                max="6"
                step="1"
                value="<%= datos.personas || '' %>"
                placeholder="De 1 a 6"
            >

        </div>


        <div class="acciones-formulario campo-completo">

            <button
                type="submit"
                class="boton boton-azul"
            >
                Confirmar reserva
            </button>

            <a
                href="/reservas"
                class="boton boton-claro"
            >
                Cancelar
            </a>

        </div>

    </form>

</section>