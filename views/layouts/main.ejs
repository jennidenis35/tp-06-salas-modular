<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Sistema de reservas de salas de estudio"
    >

    <title><%= titulo %> | Salas de Estudio</title>

    <link
        rel="stylesheet"
        href="/css/estilos.css"
    >
</head>

<body>

    <header class="encabezado">
        <div class="contenedor nav-contenedor">

            <a
                href="/"
                class="logo"
                aria-label="Ir al inicio"
            >
                📚 SalaEstudio
            </a>

            <nav aria-label="Navegación principal">
                <a href="/">Inicio</a>
                <a href="/reservas">Reservas</a>
                <a href="/reservas/nueva">Nueva reserva</a>
            </nav>

        </div>
    </header>


    <main class="contenedor contenido-principal">

        <%- body %>

    </main>


    <footer class="pie">

        <div class="contenedor">

            <p>
                Trabajo Práctico 05 ·
                Reservas de salas de estudio
            </p>

            <p class="solicitud">
                Solicitud:
                <strong>
                    <%= solicitudId %>
                </strong>
            </p>

        </div>

    </footer>

</body>
</html>